#!/usr/bin/python3
"""Install and operate Tailscale on Ubuntu for the NanoKVM extension API.

Usage: vim4-tailscale status|install|uninstall|start|stop|restart|up|down|login|logout
Prints one JSON object. Packages come from Tailscale's signed apt repository.
"""
import json
import os
from pathlib import Path
import re
import subprocess
import sys
import time
import urllib.request

KEYRING = Path('/usr/share/keyrings/tailscale-archive-keyring.gpg')
SOURCES = Path('/etc/apt/sources.list.d/tailscale.list')
REPOSITORY = 'https://pkgs.tailscale.com/stable/ubuntu'
LOGIN_LOG = Path('/run/vim4-tailscale-login.log')
URL = re.compile(r'https://login\.tailscale\.com/\S+')


def run(*args, timeout=60, check=True):
    result = subprocess.run(args, capture_output=True, text=True, timeout=timeout,
                            env={**os.environ, 'LC_ALL': 'C', 'DEBIAN_FRONTEND': 'noninteractive'})
    if check and result.returncode:
        raise RuntimeError(f'{args[0]} {args[1] if len(args) > 1 else ""} failed: {result.stderr.strip()[-300:]}')
    return result


def installed():
    return Path('/usr/bin/tailscale').exists() and Path('/usr/sbin/tailscaled').exists()


def codename():
    for line in Path('/etc/os-release').read_text().splitlines():
        if line.startswith('VERSION_CODENAME='):
            name = line.split('=', 1)[1].strip('"')
            if re.fullmatch(r'[a-z]+', name):
                return name
    raise RuntimeError('unknown Ubuntu release')


def install():
    if not installed():
        release = codename()
        with urllib.request.urlopen(f'{REPOSITORY}/{release}.noarmor.gpg', timeout=30) as response:
            key = response.read(65536)
        KEYRING.write_bytes(key)
        KEYRING.chmod(0o644)
        SOURCES.write_text(f'deb [signed-by={KEYRING}] {REPOSITORY} {release} main\n')
        # Refresh only this source; other repositories are not touched.
        run('apt-get', 'update', '-o', f'Dir::Etc::sourcelist={SOURCES}', '-o', 'Dir::Etc::sourceparts=-',
            '-o', 'APT::Get::List-Cleanup=0', timeout=180)
        run('apt-get', 'install', '-y', '--no-install-recommends', 'tailscale', timeout=600)
    run('systemctl', 'enable', '--now', 'tailscaled.service')
    return {}


def uninstall():
    if installed():
        run('systemctl', 'disable', '--now', 'tailscaled.service', check=False)
        run('apt-get', 'remove', '-y', 'tailscale', timeout=300)
    for file in (SOURCES, KEYRING):
        file.unlink(missing_ok=True)
    return {}


def status():
    if not installed():
        return {'installed': False}
    result = run('tailscale', 'status', '--json', timeout=15, check=False)
    output = result.stdout
    if result.returncode or '{' not in output:
        return {'installed': True, 'running': False}
    status = json.loads(output[output.index('{'):])
    self = status.get('Self') or {}
    tailnet = status.get('CurrentTailnet') or {}
    return {'installed': True, 'running': True, 'backendState': status.get('BackendState', ''),
            'hostName': self.get('HostName', ''), 'ips': self.get('TailscaleIPs') or [],
            'tailnet': tailnet.get('Name', '')}


def login():
    current = status()
    if current.get('backendState') == 'Running':
        return {'url': ''}
    if not current.get('running'):
        run('systemctl', 'enable', '--now', 'tailscaled.service')
        time.sleep(2)
    # The login command waits for browser authorization; leave it running
    # detached and return the URL it prints.
    with LOGIN_LOG.open('w') as log:
        subprocess.Popen(['tailscale', 'login', '--accept-dns=false', '--timeout=10m'],
                         stdin=subprocess.DEVNULL, stdout=log, stderr=log, start_new_session=True)
    deadline = time.monotonic() + 30
    while time.monotonic() < deadline:
        match = URL.search(LOGIN_LOG.read_text())
        if match:
            return {'url': match.group(0)}
        time.sleep(0.5)
    raise RuntimeError('tailscale did not provide a login URL')


def command(*args, timeout=60):
    def action():
        run(*args, timeout=timeout)
        return {}
    return action


ACTIONS = {
    'status': status,
    'install': install,
    'uninstall': uninstall,
    'login': login,
    'start': command('systemctl', 'enable', '--now', 'tailscaled.service'),
    'stop': command('systemctl', 'disable', '--now', 'tailscaled.service'),
    'restart': command('systemctl', 'restart', 'tailscaled.service'),
    'up': command('tailscale', 'up', '--accept-dns=false', '--timeout=20s', timeout=30),
    'down': command('tailscale', 'down', timeout=30),
    'logout': command('tailscale', 'logout', timeout=30),
}


def main(args):
    if len(args) != 1 or args[0] not in ACTIONS:
        raise ValueError('invalid arguments')
    if args[0] not in ('status', 'install', 'uninstall') and not installed():
        raise RuntimeError('tailscale is not installed')
    print(json.dumps(ACTIONS[args[0]]()))


if __name__ == '__main__':
    try:
        main(sys.argv[1:])
    except (OSError, ValueError, RuntimeError, subprocess.TimeoutExpired, json.JSONDecodeError) as error:
        print(error, file=sys.stderr)
        sys.exit(1)
