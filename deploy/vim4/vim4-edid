#!/usr/bin/python3
"""Load and persist the EDID advertised by the KVM HDMI input.

Usage: vim4-edid status | restore | reclaim | preset NAME | apply NAME < edid.bin

Presets: VIM4-4K60 (default), VIM4-1080P60, RTK-CONTROL (RTK UHD HDR 4K60).
"""
import fcntl
import os
from pathlib import Path
import re
import subprocess
import sys
import time

# HDMI RX port B feeds vdin0; the driver numbers ports from 1 in its uapi.
PORT = 1
EDID_WITH_PORT = Path('/sys/class/hdmirx/hdmirx0/edid_with_port')
EDID_SELECT = Path('/sys/class/hdmirx/hdmirx0/edid_select')
HDMIRX = '/dev/hdmirx0'
HDMI_IOC_EDID_UPDATE_WITH_PORT = 0x40014813  # _IOW('H', 0x13, unsigned char)
# tvserver writes this selection before it loads its own EDID set at startup.
TVSERVER_PENDING = '0x222'
STATE = Path('/var/lib/vim4-kvm/edid')
LOCK = '/run/lock/vim4-edid.lock'
# Records the tvserver run and the table it holds, so capture restarts do not
# pulse HPD. Shared with JetKVM's helper, which writes the same format.
LOADED = Path('/run/vim4-edid.loaded')
PRESETS = {
    'VIM4-4K60': Path('/etc/tvconfig/hdmi/port1_20.bin'),
    'VIM4-1080P60': Path('/etc/tvconfig/hdmi/port1_14.bin'),
}
# Unmodified EDID read from a physical RTK UHD HDR display; carried inline so
# every application offers the same table without a separate data file.
RTK_UHD_HDR = 'RTK-CONTROL'
RTK_UHD_HDR_EDID = bytes.fromhex(
    '00FFFFFFFFFFFF004A8B1A1B000000002B1E0103A20000783E6435A5544F9E27'
    '125054210800D1C0A9C081C00101010101010101010140D000A0F0703E803020'
    '350061632100001A000000FC0052544B20554844204844520A20000000FF0064'
    '656D6F7365742D310A203020000000FD00283D1E873C000A202020202020014F'
    '020348F151044C5D5E5F606100000000006768696A6BE305C00023097F078301'
    '0000E50F00000C0067030C001000387867D85DC401788801E606050169694F68'
    '1A00000101283DE6023A801871382D40582C450061632100001E565E00A0A0A0'
    '29503020350061632100001E0000000000000000000000000000000000000096'
)
DEFAULT = 'VIM4-4K60'
NAME = re.compile(r'^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$')


def validate(edid):
    """Return the EDID padded to the driver's 256-byte slot."""
    if len(edid) not in (128, 256):
        raise ValueError('EDID must contain one or two 128-byte blocks')
    if edid[:8] != bytes([0, 255, 255, 255, 255, 255, 255, 0]):
        raise ValueError('missing EDID header')
    if edid[126] != len(edid) // 128 - 1:
        raise ValueError('EDID extension count does not match its size')
    for offset in range(0, len(edid), 128):
        if sum(edid[offset:offset + 128]) % 256:
            raise ValueError('EDID block checksum mismatch')
    return edid + bytes(256 - len(edid))


def tvserver_run():
    return subprocess.run(['systemctl', 'show', '-p', 'InvocationID', '--value', 'tvserver.service'],
                          capture_output=True, text=True, timeout=10).stdout.strip()


def load(edid):
    # The same EDID fills the 1.4 and 2.0 slots so tvserver's later version
    # selection cannot switch the host back to a vendor table.
    with EDID_WITH_PORT.open('wb', buffering=0) as sysfs:
        sysfs.write(bytes([PORT + 1]) + edid + edid)
    fd = os.open(HDMIRX, os.O_RDWR)
    try:
        fcntl.ioctl(fd, HDMI_IOC_EDID_UPDATE_WITH_PORT, bytes([PORT + 1]))
    finally:
        os.close(fd)
    LOADED.write_text(f'{tvserver_run()} {edid.hex()}\n')


def persist(name, edid):
    STATE.mkdir(mode=0o755, parents=True, exist_ok=True)
    for file, content in (('active.bin', edid), ('active.name', name.encode() + b'\n')):
        pending = STATE / ('.' + file)
        pending.write_bytes(content)
        os.replace(pending, STATE / file)


def active():
    try:
        name = (STATE / 'active.name').read_text().strip()
        return name, validate((STATE / 'active.bin').read_bytes())
    except (OSError, ValueError):
        return None, None


def apply(name, edid):
    load(validate(edid))
    if name != DEFAULT:
        persist(name, edid)
        return
    # The default needs no boot override; tvserver loads it by itself.
    for file in ('active.name', 'active.bin'):
        (STATE / file).unlink(missing_ok=True)


def restore(reclaim=False):
    """Reload the selected EDID once per tvserver run.

    reclaim also reloads when this run holds another table, such as one
    JetKVM loaded; capture restarts must not, as JetKVM may be running.
    """
    name, edid = active()
    run = tvserver_run()
    loaded = LOADED.read_text().strip() if LOADED.exists() else ''
    if run and loaded.startswith(f'{run} ') and not reclaim:
        return
    if not edid:
        # tvserver loads the default itself at boot.
        if not loaded.startswith(f'{run} '):
            return
        edid = validate(PRESETS[DEFAULT].read_bytes())
    if run and loaded == f'{run} {edid.hex()}':
        return
    deadline = time.monotonic() + 20
    while TVSERVER_PENDING in EDID_SELECT.read_text() and time.monotonic() < deadline:
        time.sleep(0.1)
    load(edid)


def main(args):
    with open(LOCK, 'w') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        if args == ['status']:
            print(active()[0] or DEFAULT)
        elif args == ['restore']:
            restore()
        elif args == ['reclaim']:
            restore(reclaim=True)
        elif len(args) == 2 and args[0] == 'preset' and args[1] in PRESETS:
            apply(args[1], PRESETS[args[1]].read_bytes())
        elif args == ['preset', RTK_UHD_HDR]:
            apply(RTK_UHD_HDR, RTK_UHD_HDR_EDID)
        elif len(args) == 2 and args[0] == 'apply' and NAME.match(args[1]) and args[1] not in PRESETS:
            edid = sys.stdin.buffer.read(257)
            # vim4-manager loads its catalogue copy by name; keep the name tied to the table.
            if args[1] == RTK_UHD_HDR and edid != RTK_UHD_HDR_EDID:
                raise ValueError('RTK-CONTROL must be the built-in RTK UHD HDR EDID')
            apply(args[1], edid)
        else:
            raise ValueError('invalid arguments')


if __name__ == '__main__':
    try:
        main(sys.argv[1:])
    except (OSError, ValueError) as error:
        print(error, file=sys.stderr)
        sys.exit(1)
