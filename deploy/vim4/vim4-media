#!/usr/bin/python3
"""Switch image media, the USB microphone and NCM while retaining HID functions and the PD contract."""
import json
import os
from pathlib import Path
import subprocess
import sys
import tempfile
import time

sys.path.insert(0, '/usr/lib/vim4-kvm/python')
import vim4media

IMAGES = Path('/var/lib/vim4-kvm/images')
GADGET = Path('/sys/kernel/config/usb_gadget/kvm')
LUN = GADGET / 'functions/mass_storage.disk0/lun.0'
USB_DIR = Path('/var/lib/vim4-kvm/usb')
USB_IMAGE = USB_DIR / 'disk.img'
USB_ENABLED = USB_DIR / 'enabled'
USB_SIZE = 512 * 1024 * 1024


def usb_disk_fd():
    """Create a private FAT32 disk once; never format existing user data."""
    USB_DIR.mkdir(mode=0o755, parents=True, exist_ok=True)
    if not USB_IMAGE.exists():
        fd, temp = tempfile.mkstemp(prefix='.disk-', dir=USB_DIR)
        try:
            os.posix_fallocate(fd, 0, USB_SIZE)
            subprocess.run(['mkfs.vfat', '-F', '32', '-n', 'Vim4KVM', f'/proc/self/fd/{fd}'],
                           pass_fds=(fd,), check=True, capture_output=True)
            os.fsync(fd)
            os.link(temp, USB_IMAGE)
        finally:
            os.close(fd)
            os.unlink(temp)
    return vim4media.open_image('data/disk.img', readonly=False)


def image_fd(name, writable):
    return vim4media.open_image(image_id(name), readonly=not writable)


def image_id(name):
    path = Path(name)
    if path.is_absolute():
        for source, root in {**vim4media.IMAGE_ROOTS, 'data': vim4media.DATA_DIR}.items():
            if path.is_relative_to(root):
                return source + '/' + str(path.relative_to(root))
        raise ValueError('Invalid image path')
    return name


FUNCTIONS = ('ncm.usb0', 'mass_storage.disk0', 'uac2.usb0')


def desired_links(mounted, microphone):
    # NCM plus three HID functions already uses five IN endpoints; a sixth
    # fails CRG CONFIG_EP on this board, so NCM yields to media or microphone.
    links = (['mass_storage.disk0'] if mounted else []) + (['uac2.usb0'] if microphone else [])
    return links or ['ncm.usb0']


def relink(links, prepare=lambda: None, restore=lambda: None):
    """Re-enumerate with exactly the given switchable functions linked."""
    config = GADGET / 'configs/c.1'
    udc = GADGET / 'UDC'
    controller = udc.read_text().strip()
    old_links = [name for name in FUNCTIONS if (config / name).is_symlink()]
    if controller:
        udc.write_text('\n')
        # Allow the host to observe removal before presenting new interfaces.
        time.sleep(0.5)
    try:
        for name in FUNCTIONS:
            (config / name).unlink(missing_ok=True)
        # The function and device nodes remain alive. Only enumeration changes.
        prepare()
        for name in links:
            (config / name).symlink_to(GADGET / 'functions' / name)
    except Exception:
        for name in FUNCTIONS:
            (config / name).unlink(missing_ok=True)
        restore()
        for name in old_links:
            (config / name).symlink_to(GADGET / 'functions' / name)
        raise
    finally:
        if controller:
            udc.write_text(controller)


def configure(fd, cdrom, readonly):
    if not LUN.is_dir():
        raise RuntimeError('Virtual media gadget is not installed')
    old = {key: (LUN / key).read_text().strip() for key in ('file', 'cdrom', 'ro')}
    microphone = (GADGET / 'configs/c.1/uac2.usb0').is_symlink()

    def prepare():
        (LUN / 'file').write_text('\n')
        (LUN / 'cdrom').write_text('1' if cdrom else '0')
        (LUN / 'ro').write_text('1' if readonly else '0')
        if fd is not None:
            # Passing the already-validated descriptor prevents a path swap
            # between checking an image and the kernel opening its backing file.
            (LUN / 'file').write_text(f'/proc/self/fd/{fd}')

    def restore():
        (LUN / 'file').write_text('\n')
        for key in ('cdrom', 'ro'):
            (LUN / key).write_text(old[key] or '\n')
        if old['file']:
            restore_fd = image_fd(old['file'], old['ro'] != '1')
            try:
                (LUN / 'file').write_text(f'/proc/self/fd/{restore_fd}')
            finally:
                os.close(restore_fd)

    relink(desired_links(fd is not None, microphone), prepare, restore)


def set_microphone(enabled):
    if not (GADGET / 'functions/uac2.usb0').is_dir():
        raise RuntimeError('USB microphone gadget is not installed')
    mounted = LUN.is_dir() and bool((LUN / 'file').read_text().strip())
    relink(desired_links(mounted, enabled))


def main(args):
    if args == ['catalog']:
        print(json.dumps(vim4media.catalog()))
        return
    fd = None
    microphone = None
    disk = None
    if len(args) == 2 and args[0] == 'eject':
        cdrom, readonly = False, True
    elif len(args) == 2 and args[0] == 'microphone' and args[1] in ('on', 'off'):
        microphone = args[1] == 'on'
    elif len(args) in (2, 3) and args[0] == 'disk' and args[1] in ('on', 'off', 'restore'):
        disk = args[1]
        # Compatibility with older service units: a saved preference must
        # never reconnect media that the USB host safely ejected.
        if disk == 'restore':
            return
        cdrom, readonly = False, False
    elif len(args) == 4 and args[0] == 'mount' and all(x in ('true', 'false') for x in args[2:]):
        cdrom = args[2] == 'true'
        readonly = args[3] == 'true'
        identifier = image_id(args[1])
        source = identifier.split('/')[0]
        cdrom = cdrom or (source != 'shared' and identifier.lower().endswith('.iso'))
        if source == 'data':
            cdrom = False
        readonly = readonly or cdrom or source not in ('shared', 'data')
    else:
        raise ValueError('Usage: vim4-media eject EXPECTED_PATH | mount IMAGE CDROM READONLY | microphone on|off | disk on|restore | disk off EXPECTED_PATH')
    try:
        with vim4media.media_locks(wait=True):
            current = vim4media.LUN_FILE.read_text().strip()
            if microphone is None:
                expected = args[1] if args[0] == 'eject' else (args[2] if disk == 'off' and len(args) == 3 else '')
                if current != expected or (disk == 'off' and expected != str(USB_IMAGE)):
                    raise ValueError('Media changed or is occupied; safely eject it in the management panel')
            if args[0] == 'mount':
                fd = image_fd(identifier, not readonly)
            if disk == 'on':
                fd = usb_disk_fd()
            if microphone is None:
                configure(fd, cdrom, readonly)
                if disk == 'on':
                    USB_ENABLED.touch(mode=0o600)
                else:
                    USB_ENABLED.unlink(missing_ok=True)
                os.sync()
                print(json.dumps({'file': vim4media.LUN_FILE.read_text().strip()}))
            else:
                set_microphone(microphone)
    finally:
        if fd is not None:
            os.close(fd)


if __name__ == '__main__':
    try:
        main(sys.argv[1:])
    except (OSError, ValueError, RuntimeError, subprocess.CalledProcessError) as error:
        print(str(error), file=sys.stderr)
        sys.exit(1)
